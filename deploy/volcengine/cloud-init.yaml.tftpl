#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - git

write_files:
  - path: /opt/agent-launchpad.env
    permissions: "0600"
    encoding: b64
    content: ${runtime_env_b64}

runcmd:
  - curl -fsSL https://get.docker.com -o /opt/get-docker.sh
  - sh /opt/get-docker.sh
  - systemctl enable --now docker
  - mkdir -p /opt/agent-launchpad
  - git clone --filter=blob:none --no-checkout '${repository_url}' /opt/agent-launchpad/app
  - git -C /opt/agent-launchpad/app fetch --depth 1 origin '${repository_ref}'
  - git -C /opt/agent-launchpad/app checkout --detach FETCH_HEAD
  - cp /opt/agent-launchpad.env /opt/agent-launchpad/app/.deployment-meta
  - mkdir -p /opt/agent-launchpad/app/data /opt/agent-launchpad/app/workspaces /opt/agent-launchpad/app/codex-home
  - chown -R 1000:1000 /opt/agent-launchpad/app/data /opt/agent-launchpad/app/workspaces /opt/agent-launchpad/app/codex-home
