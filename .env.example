# ModelArk inference (used by the supervisor and Agent workers).
# This is separate from the BytePlus management AK/SK below.
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_API_KEY=replace-with-your-ark-api-key
# Default supervisor model/endpoint ID; it is not a worker fallback. Insights ›
# Supervisor model can override this per server, and that choice wins from then
# on. Whichever endpoint is active is reserved for routing: it is withheld from
# Agent (worker) selection, and Agents assigned to it are moved off it.
SUPERVISOR_MODEL=replace-with-your-supervisor-endpoint-id

# ModelArk management API (server-only signed ListEndpoints and
# GetInferenceUsage calls for worker endpoint discovery and usage telemetry).
# Never expose these credentials to the browser or Agent runtime containers.
BYTEPLUS_ACCESS_KEY=replace-with-your-byteplus-access-key
BYTEPLUS_SECRET_KEY=replace-with-your-byteplus-secret-key
BYTEPLUS_REGION=ap-southeast-1
BYTEPLUS_MANAGEMENT_BASE_URL=https://ark.ap-southeast-1.byteplusapi.com
# Optional cache/network tuning. Endpoint discovery defaults to 10 minutes;
# usage and model-activation quota snapshots are capped at a short 20-second
# cache. Quota totals come from ListModelActivations; no quota value is
# configured in this file.
# WORKER_MODEL_CACHE_TTL_MS=600000
# BYTEPLUS_MANAGEMENT_TIMEOUT_MS=10000
# BYTEPLUS_MANAGEMENT_MAX_RESPONSE_BYTES=524288

# npm run dev (host development) loads this file automatically via
# tsx's --env-file-if-exists. Repository-backed authorization is always used.
HOST=127.0.0.1

# PostgreSQL is the normal persistence backend. Set json only for an explicit
# legacy/recovery run against APP_DATA_DIR/launchpad.json.
PERSISTENCE_BACKEND=postgres
# PERSISTENCE_BACKEND=json
# Runtime login only: do not use the migration owner here.
# DATABASE_URL=postgresql://launchpad_app:YOUR_PASSWORD@127.0.0.1:5432/launchpad
# Migration/import commands only; never pass owner credentials to the server.
# DATABASE_ADMIN_URL=postgresql://launchpad_owner:YOUR_PASSWORD@127.0.0.1:5432/launchpad
# DATABASE_RUNTIME_PASSWORD=YOUR_RUNTIME_PASSWORD
# POSTGRES_PASSWORD=YOUR_OWNER_PASSWORD
# POSTGRES_PORT=5432

# No `codex` executable on the host? Run Agents in the containerized runtime
# instead of local-process. Build the image once with:
#   docker build -f Dockerfile.runtime -t volc-agent-runtime:local .
# RUNTIME_PROVIDER=container
# CONTAINER_ENGINE=docker
# MCP_CONTAINER_URL=http://host.docker.internal:3000/mcp
# Per-run tool-catalogue scoping is opt-in. Omit or set false to advertise the
# complete legacy catalogue while keeping the same execution authorization.
# MCP_SCOPED_ADVERTISEMENT=false

# Source checkpoints for shared Workspaces: a private Git snapshot of eligible
# source files before each Team cycle and after every successful Agent turn,
# with "Restore after <Agent> and resume" in the conversation. Off by default.
# The container runtime proves a worker stopped writing; local-process mode
# is admitted only with the explicit development override below.
# WORKSPACE_CHECKPOINTS_ENABLED=true
# WORKSPACE_CHECKPOINT_LOCAL_PROCESS=allow
# WORKSPACE_CHECKPOINT_GIT_BIN=git

# Local-first research. npm run poc starts SearXNG automatically when this
# endpoint is omitted; Compose uses the service name below.
SEARCH_PROVIDER=searxng
SEARXNG_AUTO_START=1

# Optional hosted provider (only used with SEARCH_PROVIDER=brave)
# BRAVE_SEARCH_API_KEY=replace-with-your-brave-api-key

# Optional direct URL-fetch limits
WEB_FETCH_TIMEOUT_MS=15000
WEB_FETCH_MAX_RESPONSE_BYTES=1048576
WEB_FETCH_MAX_REDIRECTS=3

# Per-model context windows, as modelId=tokens pairs, used to report how much
# of a model's window each Run leaves free. Neither Codex nor the ModelArk
# catalogue reports a window, so it has to be stated here; a model left out of
# this list shows its remaining context as unknown rather than as a guess.
# MODEL_CONTEXT_WINDOWS=doubao-seed-1-6-250615=256000,kimi-k2-250905=128000
