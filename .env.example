# =============================================================================
# Volc Agent Launchpad - example environment
# =============================================================================
# Copy to `.env` and fill in real values:  cp .env.example .env
#
# NEVER commit a real `.env`. NEVER put a real secret in THIS file.
# Provider keys and tokens here use obvious placeholders on purpose; the
# application rejects values that still start with `replace-`.
#
# Status legend:
#   [baseline]  read by the current starter code today (apps/server/src/config.ts,
#               docker-compose.yml, scripts/start-local-poc.sh).
#   [planned]   part of the Secretless Multi-Agent Control Plane target design
#               (tasks/plan.md). Not consumed yet; safe to leave unset until the
#               matching task lands.
# =============================================================================


# -----------------------------------------------------------------------------
# Core - control plane process (apps/server)
# -----------------------------------------------------------------------------

# [baseline] Bind address for the Fastify control plane.
# `npm run poc` forces 127.0.0.1; docker-compose forces 0.0.0.0.
HOST=127.0.0.1

# [baseline] HTTP port for the control plane / static web UI.
PORT=3000

# [baseline] Published host port for `docker compose up` (maps to container :3000).
PUBLIC_PORT=3000

# [baseline] Pino log level: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info

# [baseline] Node environment: development | test | production.
# `npm run poc` and docker-compose set this to `production`.
NODE_ENV=development

# [baseline] Directory for the JSON store (Database v2 lives here).
# Use a repo-relative path when running outside Docker.
APP_DATA_DIR=.data

# [baseline] Root directory for per-Agent persistent workspaces.
AGENT_WORKSPACE_ROOT=workspaces

# [baseline] Single override for all local POC state directories.
# When set, scripts/start-local-poc.sh uses:
#   $LOCAL_POC_DATA_ROOT/data, $LOCAL_POC_DATA_ROOT/workspaces, $LOCAL_POC_DATA_ROOT/codex-home
# Leave unset to accept the per-OS default (~/.volc-agent-launchpad on macOS,
# ./.local on Linux).
# LOCAL_POC_DATA_ROOT=/absolute/path/to/launchpad-state

# [baseline] Alternate env file for docker-compose (`--env-file` equivalent).
# LAUNCHPAD_ENV_FILE=.env


# -----------------------------------------------------------------------------
# Codex / Runtime - how one Agent turn is executed
# -----------------------------------------------------------------------------

# [baseline] Sanitized Codex home mounted into the Runtime (config.toml, auth cache).
CODEX_HOME=codex-home

# [baseline] Codex executable name / path used by the local-process runner.
CODEX_BIN=codex

# [baseline] Codex inner sandbox: read-only | workspace-write | danger-full-access.
# start-local-poc.sh downgrades to danger-full-access only if Landlock is
# unavailable, and only inside the disposable container boundary.
CODEX_SANDBOX_MODE=workspace-write

# [baseline] Hard wall-clock limit for a single Codex turn, in milliseconds.
CODEX_TIMEOUT_MS=600000

# [baseline] Maximum captured stdout bytes from one Codex turn.
CODEX_MAX_OUTPUT_BYTES=2097152

# [baseline] Runtime seam: local-process (host Codex) | container (disposable).
# start-local-poc.sh forces `container`.
RUNTIME_PROVIDER=local-process

# [baseline] Stable id used to label and reap this checkout's Runtime containers.
RUNTIME_INSTANCE_ID=default

# [planned] Secretless profile: which allowlisted gateway provider id the
# control plane binds run leases to. Must match an id in GATEWAY_PROVIDERS.
RUNTIME_PROVIDER_ID=mock

# [planned] Model id the control plane binds run leases to and injects into the
# Runtime container per run (protected gateway profile). Falls back to ARK_MODEL.
# MODEL_ID=mock-responses-1


# -----------------------------------------------------------------------------
# Container - disposable Runtime container limits (RUNTIME_PROVIDER=container)
# -----------------------------------------------------------------------------

# [baseline] Container engine binary: docker | podman | nerdctl. Colima uses `docker`.
CONTAINER_ENGINE=docker

# [baseline] Tag for the built Runtime image (Dockerfile.runtime).
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local

# [baseline] Base image for the Runtime and app builds (Dockerfile / Dockerfile.runtime).
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim

# [baseline] Per-turn resource ceilings.
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256

# [baseline] uid:gid the Runtime container runs as. Defaults to the host user
# (`id -u`:`id -g`) so bind-mounted files stay writable.
# CONTAINER_USER=1000:1000

# [baseline] Optional Debian mirrors / package list for offline image builds.
# CONTAINER_APT_MIRROR=
# CONTAINER_APT_SECURITY_MIRROR=
# CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep

# [planned] Name of the internal Docker/Podman network that connects the Runtime
# to the gateway ONLY (no direct provider or public egress). Task 6.
# RUNTIME_GATEWAY_NETWORK=launchpad-gateway-internal


# -----------------------------------------------------------------------------
# Gateway - trusted model-gateway sidecar (tasks/plan.md sections 3, 5, 8)  [planned]
# -----------------------------------------------------------------------------
# IMPORTANT: every variable in THIS section and the PROVIDER_* block below is
# read by the gateway sidecar process only (apps/server/src/gateway/config.ts).
# The control plane never reads a provider key in the protected profile - it
# reaches the gateway management API over MODEL_GATEWAY_URL using
# MODEL_GATEWAY_ADMIN_TOKEN. The Runtime container never receives any of these;
# it gets only a short-lived opaque lease.

# [planned] Bind host for the gateway process.
MODEL_GATEWAY_HOST=127.0.0.1

# [planned] Bind port for the gateway process.
MODEL_GATEWAY_PORT=4000

# [planned] Base URL other trusted processes use to reach the gateway.
#   - control plane -> POST /internal/leases, /internal/leases/:id/revocations
#   - Runtime       -> POST /p/:providerId/v1/responses  (data plane, lease only)
MODEL_GATEWAY_URL=http://127.0.0.1:4000

# [planned] Gateway-admin capability required by the /internal/* management API.
# Held by the control plane only. NEVER injected into a Runtime container.
MODEL_GATEWAY_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# [planned] Per-run opaque lease the Runtime presents as `Authorization: Bearer <lease>`.
# Minted per run by the gateway, injected into the container by the control plane,
# revoked on completion / Kill. Never set here, never persisted raw.
# MODEL_GATEWAY_TOKEN=<issued-per-run>

# [planned] Comma-separated provider ids the gateway will register and allow.
# Each id <ID> is uppercased to form the PROVIDER_<ID>_* keys below.
GATEWAY_PROVIDERS=ark,mock

# [planned] Per-provider descriptor pattern (repeat for every id in GATEWAY_PROVIDERS).
# The env fragment <ID> is the id upppercased with non-alphanumerics as `_`.
#   PROVIDER_<ID>_PROTOCOL   `responses-http` (live upstream) or `mock` (deterministic)
#   PROVIDER_<ID>_BASE_URL   upstream base URL (required for responses-http; never browser input)
#   PROVIDER_<ID>_MODELS     comma-separated allowlisted model / endpoint ids (>=1)
#   PROVIDER_<ID>_KEY_ENV    NAME of the env var holding this provider's credential
#                            (required for responses-http; the value stays in the gateway process only)

# Live Responses-compatible provider (BytePlus / Volcengine Ark).
PROVIDER_ARK_PROTOCOL=responses-http
PROVIDER_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
PROVIDER_ARK_MODELS=ep-your-endpoint-id
PROVIDER_ARK_KEY_ENV=ARK_API_KEY

# Deterministic mock provider - reproducible demos and tests, no credential.
PROVIDER_MOCK_PROTOCOL=mock
PROVIDER_MOCK_MODELS=mock-responses-1


# -----------------------------------------------------------------------------
# Providers - long-lived model-provider credentials (the protected asset)
# -----------------------------------------------------------------------------
# [baseline] Today ARK_API_KEY is read by the control plane AND passed into the
# Runtime container (see docs/DEVIATIONS.md).
# [planned]  In the secretless profile this value is read ONLY by the gateway
# process named via PROVIDER_ARK_KEY_ENV; it must never enter a workspace,
# Runtime env, browser response, log, trace, or screenshot.

# [baseline] Ark MODEL API key (not a BytePlus account AK/SK).
ARK_API_KEY=replace-with-your-provider-key

# [baseline] Responses-capable endpoint id (usually begins with `ep-`).
ARK_MODEL=ep-your-endpoint-id

# [baseline] Ark OpenAI-compatible base URL.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# [planned] Additional Responses-compatible providers are added purely by
# configuration - append the id to GATEWAY_PROVIDERS and add a PROVIDER_<ID>_*
# block plus its own key variable here, e.g.:
# ACME_API_KEY=replace-with-your-provider-key
# PROVIDER_ACME_PROTOCOL=responses
# PROVIDER_ACME_BASE_URL=https://api.example.com/v1
# PROVIDER_ACME_MODELS=acme-large,acme-small
# PROVIDER_ACME_KEY_ENV=ACME_API_KEY


# -----------------------------------------------------------------------------
# Auth - optional shared control-plane bearer token
# -----------------------------------------------------------------------------
# [baseline] Optional shared demo token for the control plane. May be empty on a
# loopback host. For any non-loopback / remote demo it must be 24+ URL-safe
# characters and must NOT start with `replace-` (the app refuses to start
# otherwise). This is a demo gate, not user identity or RBAC.
APP_AUTH_TOKEN=replace-with-at-least-24-random-characters
