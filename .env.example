# Required model settings
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=replace-with-your-endpoint-id

# Local-first research. npm run poc starts SearXNG automatically when this
# endpoint is omitted; Compose uses the service name below.
SEARCH_PROVIDER=searxng
SEARXNG_AUTO_START=1

# Optional hosted provider (only used with SEARCH_PROVIDER=brave)
# BRAVE_SEARCH_API_KEY=replace-with-your-brave-api-key

# Optional direct URL-fetch limits
WEB_FETCH_TIMEOUT_MS=15000
WEB_FETCH_MAX_RESPONSE_BYTES=1048576
WEB_FETCH_MAX_REDIRECTS=3
