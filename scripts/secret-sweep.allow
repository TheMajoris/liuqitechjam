# secret-sweep allowlist
#
# One entry per line. Blank lines and lines starting with # are ignored.
#
# Two forms:
#   path-fragment:regex   Suppress a hit when its file path CONTAINS
#                         <path-fragment> AND the matched line matches the
#                         extended regex <regex>. Everything after the first
#                         colon is the regex (so the regex may contain colons).
#   literal-fingerprint   Suppress a hit when the matched line CONTAINS this
#                         text verbatim. Use for a specific known-safe string.
#
# Keep this file free of real secrets - fingerprints must be non-sensitive.
# Prefer narrow, file-scoped entries over broad ones.

# --- .env.example placeholders -------------------------------------------
# The placeholders here all contain "replace-with-" and do not match any
# credential shape, so no entry is normally needed. Keep this as documentation
# of intent:
# .env.example:replace-with-

# --- synthetic tokens in redaction / auth tests -------------------------
# These test files deliberately contain credential-SHAPED but fake values so
# the redactor and the gateway auth guards can be exercised. Scoped to the
# credential shapes only, per file.
modules/telemetry/redactor.test.ts:(Bearer [A-Za-z0-9._~+/-]{16,}|glease_[A-Za-z0-9_-]{16,}|sk-[A-Za-z0-9]{16,})
gateway/app.test.ts:(Bearer [A-Za-z0-9._~+/-]{16,}|glease_[A-Za-z0-9_-]{16,})
apps/server/src/app.test.ts:Bearer a-strong-test-token
modules/model-access/gateway-client.test.ts:(Bearer [A-Za-z0-9._~+/-]{16,}|glease_[A-Za-z0-9_-]{16,})
modules/model-access/model-access.test.ts:glease_[A-Za-z0-9_-]{16,}
runtime/secretless-runner.test.ts:glease_[A-Za-z0-9_-]{16,}
container-codex-runner.test.ts:glease_[A-Za-z0-9_-]{16,}
scripts/security-checkpoint.sh:glease_[A-Za-z0-9_-]{16,}
